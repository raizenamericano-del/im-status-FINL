# Only mandatory login setting: choose a strong private password, 12–128 characters.
ADMIN_PASSWORD=
# Local development defaults; Docker sets DATA_DIR=/data/im-status-local.
# DATA_DIR=./runtime/data
# PORT=3000
# APP_ORIGIN is optional on Railway: derived from RAILWAY_PUBLIC_DOMAIN.
# For a custom domain, set its exact HTTPS origin, no trailing slash/path.
# APP_ORIGIN=https://your-custom-domain.example
# Local HTTP only; public HTTPS must use true (default in production).
# COOKIE_SECURE=false
# ENABLE_WHATSAPP=true
# No DATABASE_URL, PostgreSQL service, WORKER_URL or SERVICE_ROLE needed.
# Keys are generated privately in DATA_DIR/server-secrets.json; preserve and back up it.
